config_version=5

[application]
config/name="N VLink"
config/version="0.5.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="A modern N 1.4 reconstruction."

[display]
window/size/viewport_width=1024
window/size/viewport_height=768
window/size/window_width_override=1024
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/vsync/vsync_mode=0

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=256

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.792, 0.792, 0.816, 1)
